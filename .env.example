# Copia questo file in ".env" e metti i tuoi valori. Il file ".env" NON va mai caricato su GitHub.

# Chiave per firmare i token JWT. Generala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Durata del token in minuti (facoltativo, default 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (facoltativo). Per ora SQLite, in futuro PostgreSQL, ad esempio:
# DATABASE_URL=postgresql://utente:password@localhost:5432/ticket
DATABASE_URL=sqlite:///./ticket.db

# Primo admin, creato all'avvio se non esiste gia' (facoltativo ma consigliato)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
